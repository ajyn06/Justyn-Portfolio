---
interface Props {
  name?: string;
  tagline?: string;
}

const { 
  name = "Justyn Rubante", 
  tagline = "Web Developer" 
} = Astro.props;
---

<section class="hero" id="home">
  <div class="container hero-container">
    <div class="hero-info" data-hero="info">
      <p class="hero-greeting" data-hero="greeting">Hey There!, I'm -</p>
      <h1 class="hero-name" data-hero="title">
        <span class="typing-text"></span>
        <span class="typing-cursor">|</span>
      </h1>
      <p class="hero-tagline" data-hero="subtitle">
        <span class="tagline-role">{tagline}.</span>
        <span class="tagline-desc">I create responsive websites, admin systems, and user-friendly interfaces designed for performance, functionality, and a smooth user experience.</span>
      </p>
      
      <div class="hero-buttons" data-hero="buttons">
        <a href="https://github.com/ajyn06" target="_blank" rel="noopener noreferrer" class="btn btn-glass">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          Github
        </a>
        <a href="https://linkedin.com/in/justyn-rubante00/" target="_blank" rel="noopener noreferrer" class="btn btn-glass">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
          LinkedIn
        </a>
        <a href="mailto:justynrubante@gmail.com" class="btn btn-glass">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          Gmail
        </a>
      </div>
      
      <div class="hero-cv" data-hero="cv">
        <a href="/cv/JUSTYN RAYZEL M RUBANTE RESUME.pdf" download class="btn btn-cv">
          Download CV
        </a>
      </div>
    </div>
    
    <div class="hero-image-wrapper" data-hero="image">
      <div class="hero-image-circle">
        <img src="/img/profile-home.JPG" alt="Justyn Rubante" class="hero-image" />
      </div>
      <div class="hero-image-glow"></div>
    </div>
  </div>
</section>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding-top: 120px;
    padding-bottom: $spacing-12;

    @include md {
      padding-top: 100px;
    }
  }

  .hero-container {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: $spacing-12;

    @include lg {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: $spacing-16;
    }
  }

  .hero-info {
    flex: 1;
    text-align: center;

    @include lg {
      text-align: left;
      max-width: 600px;
    }
  }

  .hero-greeting {
    font-family: $font-primary;
    font-size: $font-size-lg;
    color: var(--text-light);
    margin-bottom: $spacing-1;
    opacity: 0;

    @include md {
      font-size: $font-size-xl;
    }
  }

  .hero-name {
    font-family: $font-title;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--text-color);
    margin-bottom: $spacing-3;
    line-height: 1.1;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;

    @include lg {
      justify-content: flex-start;
    }
  }

  .typing-text {
    display: inline-block;
  }

  .typing-cursor {
    display: inline-block;
    color: var(--primary-color);
    font-weight: 400;
    animation: blink 1s step-end infinite;
    margin-left: 2px;
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  .hero-tagline {
    font-size: $font-size-base;
    line-height: 1.7;
    margin-bottom: $spacing-6;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
    opacity: 0;

    @include lg {
      margin-left: 0;
      font-size: $font-size-lg;
    }
  }

  .tagline-role {
    color: #fff;
    font-weight: 600;
    margin-right: $spacing-2;
  }

  .tagline-desc {
    color: rgba(255, 255, 255, 0.65);
  }

  :global([data-theme='light']) .tagline-role {
    color: #1a1010;
  }

  :global([data-theme='light']) .tagline-desc {
    color: rgba(26, 16, 16, 0.7);
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: $spacing-3;
    justify-content: center;
    margin-bottom: $spacing-4;
    opacity: 0;

    @include lg {
      justify-content: flex-start;
    }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: $spacing-2;
    padding: $spacing-3 $spacing-5;
    border-radius: $radius-lg;
    font-size: $font-size-sm;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
    border: none;
  }

  .btn-glass {
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-color);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);

    &:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.3);
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
      color: var(--text-color);
    }

    svg {
      flex-shrink: 0;
    }
  }

  :global([data-theme='light']) .btn-glass {
    background: rgba(255, 255, 255, 0.5);
    border-color: rgba(0, 0, 0, 0.08);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);

    &:hover {
      background: rgba(255, 255, 255, 0.7);
      border-color: rgba(0, 0, 0, 0.15);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
    }
  }

  .hero-cv {
    opacity: 0;
    display: flex;
    justify-content: center;

    @include lg {
      justify-content: flex-start;
    }
  }

  .btn-cv {
    background: linear-gradient(135deg, $gradient-red 0%, #3d0502 100%);
    color: #fff;
    padding: $spacing-3 $spacing-8;
    border-radius: $radius-full;
    font-weight: 600;
    border: none;
    box-shadow: 0 4px 15px rgba($gradient-red, 0.4);

    &:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 25px rgba($gradient-red, 0.5);
      color: #fff;
    }
  }
  .hero-image-wrapper {
    position: relative;
    flex-shrink: 0;
    opacity: 0;
  }

  .hero-image-circle {
    position: relative;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    overflow: hidden;
    border: 4px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    z-index: 2;

    @include md {
      width: 380px;
      height: 380px;
    }

    @include lg {
      width: 450px;
      height: 450px;
    }
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .hero-image-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 350px;
    height: 350px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba($gradient-red, 0.4) 0%, transparent 70%);
    filter: blur(40px);
    z-index: 1;

    @include md {
      width: 450px;
      height: 450px;
    }

    @include lg {
      width: 520px;
      height: 520px;
    }
  }

  :global([data-theme='light']) .hero-image-circle {
    border-color: rgba(0, 0, 0, 0.1);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
  }

  :global([data-theme='light']) .hero-image-glow {
    background: radial-gradient(circle, rgba($gradient-red, 0.25) 0%, transparent 70%);
  }
</style>
