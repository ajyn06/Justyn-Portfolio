<section id="about" class="about-section">
  <div class="about-container">
    <div class="about-left" data-about="content">
      <h2 class="about-title">ABOUT ME</h2>
      <div class="about-glass">
        <div class="about-text">
          <p>
            <span class="highlight-initial">I</span> have always been drawn to computers, discovering early on my love for <span class="highlight">troubleshooting</span> and <span class="highlight">coding</span>. In 2020, I turned this passion into a hobby by exploring <span class="highlight">web development</span> and <span class="highlight">design</span>, building small projects, and learning to <span class="highlight">manage databases</span>. Pursuing a Bachelor's degree in Computer Science allowed me to deepen my skills, explore new frameworks and languages, and refine my interest in <span class="highlight">web design</span> and <span class="highlight">animation</span>.
          </p>
          <p>
            I've focused on <span class="highlight">full-stack development</span>, creating websites and systems for clients that help them engage and manage their customers more efficiently. I also collaborate with fellow developers on projects, continuously learning and turning ideas into functional, user-friendly applications that bring value to businesses.
          </p>
        </div>
      </div>
    </div>

    <div class="about-right" data-about="education">
      <div class="education-timeline">
        <div class="education-item" data-education="item">
          <div class="timeline-dot"></div>
          <div class="education-content">
            <span class="education-year">2021-2025</span>
            <h3 class="education-degree">Bachelor of Science in Computer Science</h3>
            <p class="education-school">Cavite State University Bacoor City Campus</p>
            <div class="education-image-wrapper">
              <img src="/img/CVSUB.jpg" alt="Cavite State University Bacoor City Campus" class="education-image" loading="lazy" />
            </div>
          </div>
        </div>

        <div class="education-item" data-education="item">
          <div class="timeline-dot"></div>
          <div class="education-content">
            <span class="education-year">2019-2021</span>
            <h3 class="education-degree">STEM (Science, Technology, Engineering, and Mathematics)</h3>
            <p class="education-school">Centro Escolar Las Piñas</p>
            <div class="education-image-wrapper">
              <img src="/img/CELP.jpg" alt="Centro Escolar Las Piñas" class="education-image" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .about-section {
    position: relative;
    padding: $spacing-10 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;

    @include md {
      padding: $spacing-16 0;
    }
  }

  .about-container {
    @include container;
    display: grid;
    grid-template-columns: 1fr;
    gap: $spacing-12;
    align-items: start;

    @include lg {
      grid-template-columns: 1fr 1fr;
      gap: $spacing-16;
    }
  }

  .about-left {
    opacity: 0;
    transform: translateX(-50px);
  }

  .about-title {
    font-family: $font-title;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    position: relative;
    margin-bottom: $spacing-8;
    opacity: 0;
    transform: translateY(40px);
    background: linear-gradient(135deg, var(--text-color) 0%, $secondary-color 50%, var(--text-color) 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;

    &::after {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 0;
      width: 60px;
      height: 3px;
      background: linear-gradient(90deg, $primary-color, $secondary-color);
    }
  }

  .about-glass {
    position: relative;
    background: var(--card-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--card-border);
    border-radius: $radius-xl;
    padding: $spacing-8;
    overflow: hidden;
    transition: background-color 0.6s ease, border-color 0.6s ease;

    &::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--border-color), transparent);
    }

    &::after {
      content: '';
      position: absolute;
      bottom: 0;
      right: 0;
      width: 100px;
      height: 100px;
      background: linear-gradient(135deg, transparent 50%, rgba($primary-color, 0.1) 50%);
      border-radius: 0 0 $radius-xl 0;
    }

    @include md {
      padding: $spacing-10;
    }
  }

  .about-text {
    position: relative;
    z-index: 1;

    p {
      font-family: $font-primary;
      font-size: $font-size-base;
      line-height: 1.8;
      color: var(--text-light);
      margin-bottom: $spacing-6;
      transition: color 0.6s ease;

      &:last-child {
        margin-bottom: 0;
      }

      @include md {
        font-size: $font-size-lg;
      }
    }
  }

  .highlight-initial {
    font-size: 1.5em;
    font-weight: 700;
    color: var(--text-color);
    float: left;
    line-height: 1;
    margin-right: 2px;
    margin-top: 4px;
    transition: color 0.6s ease;
  }

  .highlight {
    color: $primary-color;
    font-weight: 500;
    position: relative;
    
    &::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 100%;
      height: 1px;
      background: $primary-color;
      opacity: 0;
      transform: scaleX(0);
      transition: all 0.3s ease;
    }

    &:hover::after {
      opacity: 0.5;
      transform: scaleX(1);
    }
  }

  .about-right {
    opacity: 0;
    transform: translateX(50px);
    padding-top: 40px;
  }

  .education-timeline {
    position: relative;
    padding-left: 40px;
    margin-top: 0;

    @include lg {
      margin-top: 60px;
    }

    &::before {
      content: '';
      position: absolute;
      left: 5px;
      top: 8px;
      bottom: 8px;
      width: 2px;
      background: linear-gradient(180deg, $primary-color, rgba($primary-color, 0.2));
    }
  }

  .education-item {
    position: relative;
    margin-bottom: $spacing-10;
    cursor: pointer;

    &:last-child {
      margin-bottom: 0;
    }
  }

  .timeline-dot {
    position: absolute;
    left: -40px;
    top: 8px;
    width: 12px;
    height: 12px;
    background: var(--bg-color);
    border: 2px solid $primary-color;
    border-radius: 50%;
    z-index: 2;
    transition: all 0.3s ease, background-color 0.6s ease;

    &::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 6px;
      height: 6px;
      background: $primary-color;
      border-radius: 50%;
      opacity: 0;
      transition: opacity 0.3s ease;
    }
  }

  .education-content {
    position: relative;
  }

  .education-year {
    display: inline-block;
    font-family: $font-primary;
    font-size: $font-size-sm;
    font-weight: 500;
    color: var(--text-light);
    margin-bottom: $spacing-2;
    padding: $spacing-1 $spacing-3;
    background: rgba($primary-color, 0.15);
    border-radius: $radius-full;
    transition: color 0.6s ease;
  }

  .education-degree {
    font-family: $font-heading;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 600;
    color: var(--text-color);
    margin-bottom: $spacing-2;
    line-height: 1.3;
    transition: color 0.3s ease;
  }

  .education-school {
    font-family: $font-primary;
    font-size: $font-size-sm;
    color: var(--text-light);
    margin-bottom: 0;
    transition: color 0.3s ease;

    @include md {
      font-size: $font-size-base;
    }
  }

  .education-image-wrapper {
    max-height: 0;
    overflow: hidden;
    margin-top: 0;
    opacity: 0;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: $radius-lg;
  }

  .education-image {
    width: 100%;
    height: auto;
    max-height: 150px;
    object-fit: cover;
    border-radius: $radius-lg;
    border: 1px solid var(--card-border);
    transition: border-color 0.6s ease;

    @include md {
      max-height: 180px;
    }
  }

  .education-item:hover {
    .timeline-dot {
      transform: scale(1.2);
      box-shadow: 0 0 20px rgba($primary-color, 0.5);

      &::after {
        opacity: 1;
      }
    }

    .education-degree {
      color: $primary-color;
    }

    .education-school {
      color: var(--text-color);
    }

    .education-image-wrapper {
      max-height: 300px;
      margin-top: $spacing-4;
      opacity: 1;
    }
  }

  @media (max-width: #{$breakpoint-lg - 1px}) {
    .about-section {
      padding: $spacing-12 0;
    }

    .about-container {
      gap: $spacing-8;
    }

    .about-title {
      text-align: center;

      &::after {
        left: 50%;
        transform: translateX(-50%);
      }
    }

    .about-glass {
      padding: $spacing-6;
    }

    .education-timeline {
      max-width: 500px;
      margin: $spacing-4 auto 0;
      padding-left: 35px;

      &::before {
        left: 4px;
      }
    }

    .timeline-dot {
      left: -31px;
    }
  }

  @media (max-width: #{$breakpoint-sm - 1px}) {
    .about-section {
      padding: $spacing-10 0;
      min-height: auto;
    }

    .about-container {
      gap: $spacing-6;
    }

    .about-glass {
      padding: $spacing-4;
    }

    .about-text p {
      font-size: $font-size-sm;
      line-height: 1.7;
    }

    .education-timeline {
      padding-left: 30px;
      margin-top: $spacing-2;

      &::before {
        left: 3px;
      }
    }

    .timeline-dot {
      left: -27px;
      width: 10px;
      height: 10px;
    }

    .education-year {
      font-size: $font-size-xs;
      padding: 2px $spacing-2;
    }

    .education-degree {
      font-size: 1rem;
    }

    .education-school {
      font-size: $font-size-xs;
    }

    .education-image {
      max-height: 120px;
    }

    .education-item {
      margin-bottom: $spacing-6;
    }
  }
</style>
