<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .contact-section {
    padding: $spacing-20 0;
    position: relative;
    overflow: hidden;
  }

  .contact-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: $spacing-8;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 $spacing-4;

    @include md {
      grid-template-columns: 1fr 1fr;
      gap: $spacing-12;
      padding: 0;
    }

    @include lg {
      grid-template-columns: 1.2fr 1fr;
      gap: $spacing-16;
    }
  }

  .contact-content {
    opacity: 0;
    transform: translateX(-50px);
  }

  .contact-label {
    display: inline-block;
    font-size: $font-size-sm;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: $secondary-color;
    margin-bottom: $spacing-4;
    position: relative;
    padding-left: $spacing-8;

    &::before {
      content: '';
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 24px;
      height: 2px;
      background: linear-gradient(90deg, $primary-color, $secondary-color);
    }
  }

  .contact-title {
    font-family: $font-title;
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: $spacing-6;
    color: var(--text-color);

    .highlight {
      background: linear-gradient(135deg, $primary-color, $secondary-color);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
  }

  .contact-description {
    font-size: $font-size-lg;
    color: var(--text-light);
    line-height: 1.7;
    max-width: 500px;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: $spacing-4;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: $spacing-4;
    padding: $spacing-5 $spacing-6;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: $radius-xl;
    text-decoration: none;
    color: var(--text-color);
    transition: all 0.4s ease;
    opacity: 0;
    transform: translateX(50px);

    &:hover {
      border-color: rgba($primary-color, 0.5);
      background: rgba($primary-color, 0.05);
      transform: translateX(8px);

      .link-arrow {
        transform: translateX(8px);
        color: $secondary-color;
      }

      .link-icon {
        color: $secondary-color;
        transform: scale(1.1);
      }
    }
  }

  .link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: rgba($primary-color, 0.1);
    border-radius: $radius-lg;
    color: var(--text-light);
    transition: all 0.3s ease;

    svg {
      width: 22px;
      height: 22px;
    }
  }

  .link-text {
    flex: 1;
    font-size: $font-size-lg;
    font-weight: 600;
  }

  .link-arrow {
    font-size: $font-size-xl;
    color: var(--text-light);
    transition: all 0.3s ease;
  }

  .contact-decoration {
    margin-top: $spacing-16;
    text-align: center;
  }

  .deco-line {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-color), transparent);
    opacity: 0;
    transform: scaleX(0);
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initContactAnimations() {
    const wrapper = document.querySelector('[data-contact-wrapper]');
    const label = document.querySelector('[data-contact-label]');
    const title = document.querySelector('[data-contact-title]');
    const desc = document.querySelector('[data-contact-desc]');
    const links = document.querySelectorAll('[data-contact-link]');
    const decoLine = document.querySelector('[data-deco-line]');
    const content = document.querySelector('[data-contact-content]');

    if (!wrapper) return;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: wrapper,
        start: 'top 75%',
        toggleActions: 'play none none none',
      },
    });

    tl.to(content, {
      opacity: 1,
      x: 0,
      duration: 0.8,
      ease: 'power3.out',
    });

    tl.fromTo(label, 
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' },
      '-=0.6'
    );

    tl.fromTo(title,
      { opacity: 0, y: 30, clipPath: 'inset(0 0 100% 0)' },
      { opacity: 1, y: 0, clipPath: 'inset(0 0 0% 0)', duration: 0.8, ease: 'power3.out' },
      '-=0.4'
    );

    tl.fromTo(desc,
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' },
      '-=0.4'
    );

    tl.to(links, {
      opacity: 1,
      x: 0,
      duration: 0.6,
      stagger: 0.15,
      ease: 'power3.out',
    }, '-=0.4');

    tl.to(decoLine, {
      opacity: 1,
      scaleX: 1,
      duration: 1,
      ease: 'power2.out',
    }, '-=0.3');

    links.forEach((link) => {
      link.addEventListener('mouseenter', () => {
        gsap.to(link, {
          scale: 1.02,
          boxShadow: '0 10px 30px rgba(116, 10, 3, 0.15)',
          duration: 0.3,
          ease: 'power2.out',
        });
      });

      link.addEventListener('mouseleave', () => {
        gsap.to(link, {
          scale: 1,
          boxShadow: '0 0 0 rgba(0, 0, 0, 0)',
          duration: 0.3,
          ease: 'power2.out',
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initContactAnimations);
  document.addEventListener('astro:page-load', initContactAnimations);
</script>
