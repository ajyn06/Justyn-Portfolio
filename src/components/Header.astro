---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const navLinks = [
  { href: '#home', label: 'Home' },
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#contact', label: 'Contact' },
];
---

<header class:list={['header', className]} data-navbar>
  <nav class="nav container">
    <a href="/" class="logo">
      <img src="/img/JR-logo.png" alt="JR Logo" class="logo-img logo-dark" />
      <img src="/img/JR-logo-light.png" alt="JR Logo" class="logo-img logo-light" />
    </a>

    <div class="nav-right">
      <ul class="nav-links">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="nav-link">{link.label}</a>
          </li>
        ))}
      </ul>

      <button class="theme-toggle" aria-label="Toggle light mode" data-theme-toggle>
        <div class="theme-toggle__track">
          <div class="theme-toggle__icon">
            <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>

            <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </div>
        </div>
      </button>

      <button class="mobile-toggle" aria-label="Toggle menu" aria-expanded="false">
        <span class="hamburger"></span>
      </button>
    </div>
  </nav>
  <div class="header-divider"></div>
</header>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  :global([data-theme='light']) .header {
    background: rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(0, 0, 0, 0.08);
  }

  .nav {
    @include flex-between;
    height: 70px;
  }

  .logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;

    &:hover {
      opacity: 0.85;
    }
  }

  .logo-img {
    height: 40px;
    width: auto;
  }

  .logo-dark {
    display: block;
  }

  .logo-light {
    display: none;
  }

  :global([data-theme='light']) .logo-dark {
    display: none;
  }

  :global([data-theme='light']) .logo-light {
    display: block;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: $spacing-6;
  }

  .nav-links {
    display: none;
    gap: $spacing-8;
    flex-direction: column;

    @include md {
      display: flex;
      flex-direction: row;
      align-items: center;
    }

    &.active {
      display: flex;
      position: absolute;
      top: 70px;
      left: 0;
      right: 0;
      background: rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(20px) saturate(180%);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      flex-direction: column;
      padding: $spacing-6;
      gap: $spacing-4;

      @include md {
        display: flex;
        position: static;
        background: transparent;
        backdrop-filter: none;
        border-bottom: none;
        padding: 0;
        gap: $spacing-8;
        flex-direction: row;
      }
    }
  }

  .nav-link {
    color: var(--text-color);
    font-family: $font-primary;
    font-weight: 500;
    font-size: $font-size-sm;
    letter-spacing: 0.01em;
    position: relative;
    padding: $spacing-2 0;
    transition: color $transition-base, text-shadow $transition-base;

    &::before {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 50%;
      width: 0;
      height: 2px;
      background: var(--primary-color);
      border-radius: 2px;
      transform: translateX(-50%);
      transition: width 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
      box-shadow: 0 0 8px rgba(116, 10, 3, 0.4);
    }

    &:hover {
      color: var(--primary-color);
      text-shadow: 0 0 12px rgba(116, 10, 3, 0.35);

      &::before {
        width: 100%;
      }
    }
  }

  .theme-toggle {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1.5px solid var(--border-color);
    background: var(--toggle-bg);
    cursor: pointer;
    transition: border-color $transition-base, background $transition-base;

    &:hover {
      border-color: var(--primary-color);
    }

    &:focus-visible {
      outline: 2px solid var(--primary-color);
      outline-offset: 2px;
    }
  }

  .theme-toggle__track {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .theme-toggle__icon {
    position: relative;
    width: 16px;
    height: 16px;
    color: var(--text-color);
  }

  .icon-sun,
  .icon-moon {
    position: absolute;
    top: 0;
    left: 0;
    transition: opacity $transition-base;
  }

  .icon-sun {
    opacity: 1;
  }

  .icon-moon {
    opacity: 0;
  }

  :global([data-theme='light']) .icon-sun {
    opacity: 0;
  }

  :global([data-theme='light']) .icon-moon {
    opacity: 1;
  }

  .header-divider {
    height: 1px;
    width: 100%;
    background: var(--divider-color);
    opacity: 0.8;
  }

  .mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 40px;
    height: 40px;
    background: transparent;
    border: none;
    cursor: pointer;

    @include md {
      display: none;
    }
  }

  .hamburger {
    width: 24px;
    height: 2px;
    background: var(--text-color);
    position: relative;
    transition: background $transition-fast;

    &::before,
    &::after {
      content: '';
      position: absolute;
      left: 0;
      width: 24px;
      height: 2px;
      background: var(--text-color);
      transition: transform 0.3s ease;
    }

    &::before {
      top: -8px;
    }

    &::after {
      top: 8px;
    }
  }

  .mobile-toggle[aria-expanded='true'] .hamburger {
    background: transparent;

    &::before {
      transform: translateY(10px) rotate(45deg);
    }

    &::after {
      transform: translateY(-10px) rotate(-45deg);
    }
  }
</style>

<script>
  const mobileToggle = document.querySelector('.mobile-toggle');
  const navLinks = document.querySelector('.nav-links');

  mobileToggle?.addEventListener('click', () => {
    const isExpanded = mobileToggle.getAttribute('aria-expanded') === 'true';
    mobileToggle.setAttribute('aria-expanded', (!isExpanded).toString());
    navLinks?.classList.toggle('active');
  });
</script>
