---

<footer class="footer" data-footer>
  <div class="container">
    <div class="footer-top" data-footer-top>
      <div class="footer-brand">
        <a href="#hero" class="footer-logo">
          <img src="/img/JR-logo.png" alt="Justyn Rubante Logo" class="logo-dark" />
          <img src="/img/JR-logo-light.png" alt="Justyn Rubante Logo" class="logo-light" />
        </a>
        <p class="footer-quote">Where creativity meets code</p>
      </div>

      <div class="footer-social">
        {socialLinks.map((link) => (
          <a 
            href={link.href} 
            class="social-link" 
            target="_blank" 
            rel="noopener noreferrer"
            aria-label={link.label}
            data-social-link
          >
            <Fragment set:html={link.icon} />
          </a>
        ))}
      </div>
    </div>

    <nav class="footer-nav" data-footer-nav>
      {navLinks.map((link) => (
        <a href={link.href} class="footer-nav-link">{link.label}</a>
      ))}
    </nav>
    <div class="footer-divider" data-footer-divider></div>
    <div class="footer-bottom" data-footer-bottom>
      <p class="footer-copyright">
        &copy; {currentYear} <span class="highlight">Justyn Rubante</span>. All rights reserved.
      </p>
      
      <button class="back-to-top" data-back-to-top aria-label="Back to top">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m18 15-6-6-6 6"/>
        </svg>
      </button>
    </div>
  </div>
</footer>

<style lang="scss">
  @use '../styles/variables' as *;
  @use '../styles/mixins' as *;

  .footer {
    position: relative;
    background: linear-gradient(180deg, transparent 0%, rgba($primary-color, 0.03) 100%);
    color: var(--text-color);
    padding: $spacing-6 0 $spacing-4;
    border-top: 1px solid var(--card-border);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 $spacing-6;
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: $spacing-4;
    margin-bottom: $spacing-4;
    opacity: 0;
    transform: translateY(20px);

    @include md {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: $spacing-2;

    @include md {
      align-items: flex-start;
    }
  }

  .footer-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    text-decoration: none;
    transition: transform 0.3s ease;

    img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .logo-dark {
      display: block;
    }

    .logo-light {
      display: none;
    }

    &:hover {
      transform: scale(1.08);
    }
  }

  :global([data-theme='light']) .footer-logo {
    .logo-dark {
      display: none;
    }

    .logo-light {
      display: block;
    }
  }

  .footer-quote {
    font-size: $font-size-sm;
    color: var(--text-light);
    font-style: italic;
  }

  .footer-social {
    display: flex;
    gap: $spacing-3;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: $radius-lg;
    color: var(--text-light);
    transition: all 0.3s ease;

    &:hover {
      background: linear-gradient(135deg, $primary-color, $secondary-color);
      border-color: transparent;
      color: white;
      transform: translateY(-3px);
      box-shadow: 0 6px 20px rgba($primary-color, 0.25);
    }
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: $spacing-3 $spacing-6;
    margin-bottom: $spacing-4;
    opacity: 0;
    transform: translateY(15px);
  }

  .footer-nav-link {
    color: var(--text-color);
    text-decoration: none;
    font-size: $font-size-sm;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: $spacing-2 0;
    position: relative;
    transition: color 0.3s ease;

    &::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 2px;
      background: linear-gradient(90deg, $primary-color, $secondary-color);
      border-radius: $radius-full;
      transition: width 0.3s ease;
    }

    &:hover {
      color: $secondary-color;

      &::after {
        width: 100%;
      }
    }
  }

  .footer-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--card-border), transparent);
    margin-bottom: $spacing-3;
    opacity: 0;
    transform: scaleX(0);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: $spacing-4;
    opacity: 0;
    transform: translateY(10px);

    @include md {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .footer-copyright {
    font-size: $font-size-sm;
    color: var(--text-light);

    .highlight {
      color: var(--text-color);
      font-weight: 600;
    }
  }

  .back-to-top {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 50%;
    color: var(--text-light);
    cursor: pointer;
    transition: all 0.3s ease;

    &:hover {
      background: linear-gradient(135deg, $primary-color, $secondary-color);
      border-color: transparent;
      color: white;
      transform: translateY(-3px);
      box-shadow: 0 6px 20px rgba($primary-color, 0.25);

      svg {
        animation: bounce 0.5s ease infinite;
      }
    }
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initFooterAnimations() {
    const footer = document.querySelector('[data-footer]');
    const top = document.querySelector('[data-footer-top]');
    const nav = document.querySelector('[data-footer-nav]');
    const divider = document.querySelector('[data-footer-divider]');
    const bottom = document.querySelector('[data-footer-bottom]');
    const socialLinks = document.querySelectorAll('[data-social-link]');
    const backToTop = document.querySelector('[data-back-to-top]');

    if (!footer) return;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: footer,
        start: 'top 90%',
        toggleActions: 'play none none none',
      },
    });

    tl.to(top, {
      opacity: 1,
      y: 0,
      duration: 0.5,
      ease: 'power2.out',
    });

    tl.to(nav, {
      opacity: 1,
      y: 0,
      duration: 0.5,
      ease: 'power2.out',
    }, '-=0.3');

    tl.to(divider, {
      opacity: 1,
      scaleX: 1,
      duration: 0.6,
      ease: 'power2.out',
    }, '-=0.2');

    tl.to(bottom, {
      opacity: 1,
      y: 0,
      duration: 0.4,
      ease: 'power2.out',
    }, '-=0.3');

    socialLinks.forEach((link) => {
      link.addEventListener('mouseenter', () => {
        gsap.to(link, { scale: 1.1, duration: 0.2, ease: 'back.out(1.7)' });
      });
      link.addEventListener('mouseleave', () => {
        gsap.to(link, { scale: 1, duration: 0.2, ease: 'power2.out' });
      });
    });
    
    if (backToTop) {
      backToTop.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initFooterAnimations);
  document.addEventListener('astro:page-load', initFooterAnimations);
</script>
